{
  "name": "MLOps-Crypto-Surveillance",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/MLOps-Crypto-Surveillance",

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },

  "remoteEnv": {
    "UV_PYTHON": "3.12",
    "UV_PROJECT_ENVIRONMENT": "${containerWorkspaceFolder}/.venv",
    "VIRTUAL_ENV": "${containerWorkspaceFolder}/.venv",
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "github.copilot",
        "eamodio.gitlens",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "ms-python.black-formatter",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        },
        "python.linting.ruffEnabled": true,
        "python.linting.enabled": true
      }
    }
  },

  // recreate venv on every rebuild — fast because uv-cache volume is warm
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache/uv && uv venv --python 3.12 && uv sync --all-groups --all-extras && uv run pre-commit install",

  "forwardPorts": [8000, 8888, 3000, 9090, 6379, 5432],
  "portsAttributes": {
    "8000": { "label": "FastAPI Inference Service" },
    "8888": { "label": "Jupyter Notebook" },
    "3000": { "label": "Grafana Dashboard" },
    "9090": { "label": "Prometheus" },
    "6379": { "label": "Redis" },
    "5432": { "label": "PostgreSQL" }
  },

  "remoteUser": "vscode"
}